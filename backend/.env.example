# Copy to .env and edit. Every value here has a sensible default.

APP_ENV=development

# --- Hardware -----------------------------------------------------------------
# manual = connect from the web UI (recommended)
# serial = also connect automatically when the backend starts
# off    = disable the hardware API
HARDWARE_MODE=manual
# Port for HARDWARE_MODE=serial. "auto" picks the single ST-LINK port.
# macOS: /dev/cu.usbmodemXXXX   Windows: COM5   Linux: /dev/ttyACM0
SERIAL_PORT=auto
SERIAL_BAUDRATE=115200
SERIAL_AUTO_RECONNECT=true
# Seconds without valid data before the UI shows "Data stopped".
SERIAL_STALL_TIMEOUT_S=2.0

# DEVELOPMENT ONLY. When false (default) packets from scripts/send_test_samples.py are
# rejected, so test data can never be mistaken for INA219 measurements.
ALLOW_TEST_SOURCES=false

# Function ids used by the firmware's JL_FUNCTION_START(id) (jl_config.h) -> names.
FUNCTION_NAMES=1:sensor_read,2:compute,3:send_data,4:idle_sleep
# GPIO marker channels: 0 = PA0 (A0), 1 = PA1 (A1).
GPIO_MARKER_NAMES=0:gpio_marker_0,1:gpio_marker_1

# --- Live streaming -------------------------------------------------------------
LIVE_BUFFER_SECONDS=120
WS_BROADCAST_HZ=20
WS_MAX_SAMPLES_PER_MESSAGE=400

# --- Storage (SQLite) -------------------------------------------------------------
# Default: backend/data/joulelab.db
# DATABASE_PATH=
# Samples are stored only while a session is recording. Each stored row is the
# average of N consecutive samples: 10 -> 50 rows/s at 500 Hz (measured ~15 MB per hour).
DB_STORE_DECIMATION=10
# Stop storing raw rows after this many per session (energy summary continues).
DB_MAX_SAMPLES_PER_SESSION=2000000
# Delete finished sessions older than this many days (0 = keep forever).
RETENTION_DAYS=30

# --- Workspace: Verify / Upload / Debug (PlatformIO) ------------------------------
# Leave empty to use the pio installed in this venv (python -m pip install platformio).
PIO_PATH=
# Per-board PlatformIO projects edited by the Workspace (default backend/data/projects).
# PROJECTS_DIR=
# Kill a build/upload/debug after this many seconds. The first build of a board downloads
# its toolchain (hundreds of MB for ESP32), so keep this generous.
DEV_JOB_TIMEOUT_S=3600
DEV_MAX_SOURCE_CHARS=200000
# Build/upload/debug run programs on this computer and flash boards. false = only requests
# from this computer are accepted (including through the frontend on port 3000).
DEV_ALLOW_REMOTE=false

# "Above idle" per function uses this function's average power as the floor.
BASELINE_FUNCTION=idle_sleep

# --- Access -------------------------------------------------------------------------
# Shared secret with the frontend proxy. Empty = generated into PROXY_KEY_FILE on first start.
JOULELAB_PROXY_KEY=
# PROXY_KEY_FILE=

# --- Web --------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- AI suggestions (never put the key in frontend code) ---------------------------
# Google Gemini (get a key at https://aistudio.google.com). Pick a current model name there.
# Used by the optimizer (/api/optimizer/suggest) and by "describe your circuit" (circuit_ai.py);
# with no key both fall back to offline rules / report "AI is not configured".
GEMINI_API_KEY=
GEMINI_MODEL=
# Re-ask the model once if its optimized_code fails the sanity checks.
AI_RETRY_ON_INVALID=true
MAX_SOURCE_CHARS=30000
