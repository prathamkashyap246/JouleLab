{
  "name": "joulelab",
  "version": "1.0.0",
  "description": "JouleLab - energy budget estimator",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/app.jsx --outfile=public/js/app.js --jsx-factory=React.createElement --jsx-fragment=React.Fragment --target=es2019 --log-level=warning",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
